+package org.springframework.integration.ip.tcp.connection;
+
+import java.net.Socket;
+import java.nio.channels.SocketChannel;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Factory for mocked {@link SocketChannel} instances shared by the TCP connection tests.
+ *
+ * @author Spring Integration
+ */
+public final class MockSocketChannel {
+
+	private MockSocketChannel() {
+	}
+
+	/**
+	 * Create a mock {@link SocketChannel} whose {@code socket()} method returns the
+	 * supplied {@link Socket}.
+	 * @param socket the socket returned by {@link SocketChannel#socket()}.
+	 * @return the mock socket channel.
+	 */
+	public static SocketChannel createMockSocketChannel(Socket socket) {
+		SocketChannel socketChannel = mock(SocketChannel.class);
+		when(socketChannel.socket()).thenReturn(socket);
+		return socketChannel;
+	}
+
+}
