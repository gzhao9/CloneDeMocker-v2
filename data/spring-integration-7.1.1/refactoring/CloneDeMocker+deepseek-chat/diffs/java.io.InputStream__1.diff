+package org.springframework.integration.ip.tcp.connection;
+
+import java.io.IOException;
+import java.io.InputStream;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Shared factory methods for mocked {@link InputStream} instances used by the
+ * TCP connection tests.
+ */
+public final class MockInputStreams {
+
+	private MockInputStreams() {
+	}
+
+	/**
+	 * Create a mock {@link InputStream} whose {@link InputStream#read()} method returns
+	 * the supplied value.
+	 * @param readReturnValue the value returned from {@code read()}
+	 * @return the mock {@link InputStream}
+	 * @throws IOException as declared by {@link InputStream#read()}
+	 */
+	public static InputStream createMockInputStream(int readReturnValue) throws IOException {
+		InputStream inputStream = mock(InputStream.class);
+		when(inputStream.read()).thenReturn(readReturnValue);
+		return inputStream;
+	}
+
+}
