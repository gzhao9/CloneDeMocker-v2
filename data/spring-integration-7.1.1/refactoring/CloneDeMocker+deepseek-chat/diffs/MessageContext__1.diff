+package org.springframework.integration.ws.inbound;
+
+import org.springframework.ws.WebServiceMessage;
+import org.springframework.ws.context.MessageContext;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Factory for {@link MessageContext} mocks shared across the inbound web service tests.
+ */
+public final class MockMessageContext {
+
+	private MockMessageContext() {
+	}
+
+	/**
+	 * Create a mocked {@link MessageContext} that returns the supplied request and response
+	 * messages and exposes no property names.
+	 * @param request the message returned by {@code getRequest()}
+	 * @param response the message returned by {@code getResponse()}
+	 * @return the configured {@link MessageContext} mock
+	 */
+	public static MessageContext createMockMessageContext(WebServiceMessage request, WebServiceMessage response) {
+		MessageContext context = mock();
+		when(context.getResponse()).thenReturn(response);
+		when(context.getRequest()).thenReturn(request);
+		when(context.getPropertyNames()).thenReturn(new String[0]);
+		return context;
+	}
+
+}
