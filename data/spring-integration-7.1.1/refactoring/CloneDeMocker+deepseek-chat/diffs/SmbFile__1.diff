+package org.springframework.integration.smb.filters;
+
+import java.lang.reflect.Method;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Factory for SMB file mocks shared by the SMB file list filter tests.
+ *
+ * @author Artem Bilan
+ */
+public final class MockSmbFile {
+
+	private MockSmbFile() {
+	}
+
+	/**
+	 * Create a mock of the supplied SMB file type whose {@code getLastModified()}
+	 * method returns the provided value.
+	 * @param smbFileType the SMB file type to mock
+	 * @param lastModified the value, in milliseconds, returned from
+	 * {@code getLastModified()}
+	 * @param <T> the SMB file type
+	 * @return a mock with a stubbed {@code getLastModified()}
+	 */
+	public static <T> T createMockSmbFile(Class<T> smbFileType, long lastModified) {
+		T smbFile = mock(smbFileType);
+		try {
+			Method getLastModified = smbFileType.getMethod("getLastModified");
+			when(getLastModified.invoke(smbFile)).thenReturn(lastModified);
+		}
+		catch (ReflectiveOperationException ex) {
+			throw new IllegalStateException("Cannot stub 'getLastModified' on " + smbFileType.getName(), ex);
+		}
+		return smbFile;
+	}
+
+}
