+package com.cloud.network.guru;
+
+import com.cloud.dc.DataCenterVO;
+import com.cloud.network.Network;
+import com.cloud.network.NetworkModel;
+import com.cloud.utils.Pair;
+import org.mockito.Mockito;
+
+public final class MockNetworkModel {
+    private MockNetworkModel() {
+    }
+
+    public static void configureNetworkDns(NetworkModel networkModel, Network network, DataCenterVO dataCenter,
+            String ip4Dns1, String ip4Dns2, String ip6Dns1, String ip6Dns2) {
+        Mockito.when(networkModel.getNetworkIp4Dns(network, dataCenter)).thenReturn(new Pair<>(ip4Dns1, ip4Dns2));
+        Mockito.when(networkModel.getNetworkIp6Dns(network, dataCenter)).thenReturn(new Pair<>(ip6Dns1, ip6Dns2));
+    }
+}
