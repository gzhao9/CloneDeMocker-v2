+package com.cloud.agent.manager.allocator.impl;
+
+import com.cloud.host.HostVO;
+import com.cloud.host.dao.HostDao;
+
+import java.util.List;
+
+import org.mockito.Mockito;
+
+public class HostDaoTagRuleMockFactory {
+
+    public static void stubHostsWithTagRuleMatchingAnyString(HostDao hostDao, List<HostVO> hostsMatchingRuleTags) {
+        Mockito.doReturn(hostsMatchingRuleTags).when(hostDao).findHostsWithTagRuleThatMatchComputeOfferingTags(Mockito.anyString());
+    }
+
+    public static void stubHostsWithTagRuleMatchingNullableString(HostDao hostDao, List<HostVO> hostsMatchingRuleTags) {
+        Mockito.doReturn(hostsMatchingRuleTags).when(hostDao).findHostsWithTagRuleThatMatchComputeOfferingTags(Mockito.nullable(String.class));
+    }
+}
