+package org.apache.cloudstack.network.contrail.model;
+
+import com.cloud.vm.dao.UserVmDao;
+import net.juniper.contrail.api.ApiConnector;
+import org.apache.cloudstack.network.contrail.management.ContrailManagerImpl;
+import org.mockito.Mockito;
+
+import static org.mockito.Mockito.when;
+
+public final class MockModelControllerWithApiAndDaos {
+
+    private MockModelControllerWithApiAndDaos() {
+    }
+
+    public static ModelController createMockModelController(ApiConnector api,
+            ContrailManagerImpl contrailMgr, UserVmDao vmDao) {
+        ModelController controller = Mockito.mock(ModelController.class);
+        when(controller.getApiAccessor()).thenReturn(api);
+        when(controller.getManager()).thenReturn(contrailMgr);
+        when(controller.getVmDao()).thenReturn(vmDao);
+        return controller;
+    }
+}
