+package com.cloud.storage;
+
+import com.cloud.dc.DataCenterVO;
+import com.cloud.dc.dao.DataCenterDao;
+import org.mockito.Mockito;
+
+public final class MockDataCenterDao {
+    private MockDataCenterDao() {
+    }
+
+    public static void createMockDataCenterDao(DataCenterDao dataCenterDao, long zoneId, DataCenterVO zone) {
+        Mockito.when(dataCenterDao.findById(zoneId)).thenReturn(zone);
+    }
+
+    public static void createMockDataCenterDao(DataCenterDao dataCenterDao, DataCenterVO zone) {
+        Mockito.when(dataCenterDao.findById(Mockito.anyLong())).thenReturn(zone);
+    }
+}
