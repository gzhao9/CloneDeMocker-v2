+package org.apache.cloudstack.veeam.api.converter;
+
+import com.cloud.network.dao.NetworkVO;
+import org.mockito.Mockito;
+
+import static org.mockito.Mockito.when;
+
+public final class MockNetworkVO {
+
+    private MockNetworkVO() {
+    }
+
+    public static NetworkVO createMockNetworkVO(String uuid, String displayText) {
+        NetworkVO vo = Mockito.mock(NetworkVO.class);
+        when(vo.getUuid()).thenReturn(uuid);
+        when(vo.getDisplayText()).thenReturn(displayText);
+        return vo;
+    }
+}
