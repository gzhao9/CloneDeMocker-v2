+package com.cloud.network.guru;
+
+import com.cloud.dc.DataCenterVO;
+import com.cloud.network.Network;
+import com.cloud.network.NetworkModel;
+import com.cloud.utils.Pair;
+import org.mockito.Mockito;
+
+public class MockNetworkModel {
+
+    public static NetworkModel createMockNetworkModel(Network network, DataCenterVO dataCenter,
+            Pair<String, String> ipv4Dns, Pair<String, String> ipv6Dns) {
+        NetworkModel networkModel = Mockito.mock(NetworkModel.class);
+        Mockito.when(networkModel.getNetworkIp4Dns(network, dataCenter)).thenReturn(ipv4Dns);
+        Mockito.when(networkModel.getNetworkIp6Dns(network, dataCenter)).thenReturn(ipv6Dns);
+        return networkModel;
+    }
+}
