@@ -0,0 +1,19 @@
+package com.cloud.network.router;
+
+import com.cloud.network.dao.NetworkDao;
+import com.cloud.network.dao.NetworkVO;
+import org.mockito.Mockito;
+
+public final class MockNetworkDao {
+
+    private MockNetworkDao() {
+    }
+
+    public static void configureMockNetworkDao(NetworkDao networkDao, Long networkId, NetworkVO network) {
+        Mockito.when(networkDao.findById(networkId)).thenReturn(network);
+    }
+
+    public static void configureLenientMockNetworkDao(NetworkDao networkDao, Long networkId, NetworkVO network) {
+        Mockito.lenient().when(networkDao.findById(networkId)).thenReturn(network);
+    }
+}
