+package org.apache.cloudstack.kms;
+
+import org.apache.cloudstack.framework.kms.WrappedKey;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+public class MockWrappedKey {
+    public static WrappedKey createMockWrappedKey(byte[] wrappedKeyMaterial) {
+        WrappedKey wrappedKey = mock(WrappedKey.class);
+        when(wrappedKey.getWrappedKeyMaterial()).thenReturn(wrappedKeyMaterial);
+        return wrappedKey;
+    }
+}
