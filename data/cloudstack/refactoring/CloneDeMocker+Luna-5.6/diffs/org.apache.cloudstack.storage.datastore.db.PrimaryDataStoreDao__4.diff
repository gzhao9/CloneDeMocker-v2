+package org.apache.cloudstack.backup;
+
+import java.util.Map;
+
+import org.apache.cloudstack.storage.datastore.db.PrimaryDataStoreDao;
+import org.apache.cloudstack.storage.datastore.db.StoragePoolVO;
+
+import org.mockito.Mockito;
+
+public final class PrimaryDataStoreDaoMockFactory {
+    private PrimaryDataStoreDaoMockFactory() {
+    }
+
+    public static PrimaryDataStoreDao createMockPrimaryDataStoreDao(Map<Long, StoragePoolVO> storagePools) {
+        PrimaryDataStoreDao storagePoolDao = Mockito.mock(PrimaryDataStoreDao.class);
+        for (Map.Entry<Long, StoragePoolVO> entry : storagePools.entrySet()) {
+            Mockito.when(storagePoolDao.findById(entry.getKey())).thenReturn(entry.getValue());
+        }
+        return storagePoolDao;
+    }
+}
