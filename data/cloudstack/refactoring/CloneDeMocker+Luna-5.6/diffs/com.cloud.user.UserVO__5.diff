+package com.cloud.api;
+
+import com.cloud.user.UserVO;
+import org.mockito.Mockito;
+
+public final class MockUserVO {
+    private MockUserVO() {
+    }
+
+    public static UserVO createMockUserVO(String uuid) {
+        UserVO userVO = Mockito.mock(UserVO.class);
+        Mockito.when(userVO.getUuid()).thenReturn(uuid);
+        return userVO;
+    }
+}
