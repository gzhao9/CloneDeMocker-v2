+package com.cloud.network.element;
+
+import com.cloud.network.Network;
+import com.cloud.network.NetworkModel;
+import org.mockito.Mockito;
+
+public final class MockNetworkModel {
+    private MockNetworkModel() {
+    }
+
+    public static NetworkModel createMockNetworkModel(Network.Provider provider, long networkId,
+            Network.Service service) {
+        NetworkModel networkModel = Mockito.mock(NetworkModel.class);
+        Mockito.when(networkModel.isProviderForNetwork(provider, networkId)).thenReturn(true);
+        if (service != null) {
+            Mockito.when(networkModel.isProviderSupportServiceInNetwork(networkId, service, provider)).thenReturn(true);
+        }
+        return networkModel;
+    }
+}
