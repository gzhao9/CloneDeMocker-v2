+package com.cloud.network.router;
+
+import com.cloud.vm.NicVO;
+import org.mockito.Mockito;
+
+public final class MockNicVoWithMacAddress {
+
+    private MockNicVoWithMacAddress() {
+    }
+
+    public static NicVO createMockNicVo(String macAddress) {
+        NicVO nicVoMock = Mockito.mock(NicVO.class);
+        Mockito.when(nicVoMock.getMacAddress()).thenReturn(macAddress);
+        return nicVoMock;
+    }
+}
