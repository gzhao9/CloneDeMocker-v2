+package org.apache.cloudstack.kms;
+
+import org.apache.cloudstack.kms.dao.HSMProfileDao;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+public final class MockHSMProfileDao {
+    private MockHSMProfileDao() {
+    }
+
+    public static HSMProfileDao createMockHsmProfileDao(Long profileId, HSMProfileVO profile) {
+        HSMProfileDao hsmProfileDao = mock(HSMProfileDao.class);
+        when(hsmProfileDao.findById(profileId)).thenReturn(profile);
+        return hsmProfileDao;
+    }
+}
