+package com.cloud.hypervisor.kvm.resource.wrapper;
+
+import org.libvirt.LibvirtException;
+import org.mockito.Mockito;
+
+import static org.mockito.Mockito.when;
+
+public class MockLibvirtException {
+
+    public static LibvirtException createMockLibvirtException(String message) {
+        LibvirtException libvirtException = Mockito.mock(LibvirtException.class);
+        when(libvirtException.getMessage()).thenReturn(message);
+        return libvirtException;
+    }
+}
