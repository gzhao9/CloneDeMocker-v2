+package com.cloud.configuration;
+
+import com.cloud.storage.dao.DiskOfferingDao;
+import com.cloud.storage.DiskOfferingVO;
+import org.mockito.Mockito;
+
+public final class MockDiskOfferingDao {
+    private MockDiskOfferingDao() {
+    }
+
+    public static DiskOfferingDao createMockDiskOfferingDao(DiskOfferingVO diskOffering) {
+        DiskOfferingDao diskOfferingDao = Mockito.mock(DiskOfferingDao.class);
+        Mockito.when(diskOfferingDao.findById(Mockito.anyLong())).thenReturn(diskOffering);
+        return diskOfferingDao;
+    }
+}
