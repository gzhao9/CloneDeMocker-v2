+package com.cloud.storage.template;
+
+import com.cloud.storage.StorageLayer;
+import org.mockito.Mockito;
+
+public final class MockStorageLayer {
+    private MockStorageLayer() {
+    }
+
+    public static StorageLayer createMockStorageLayer(long size) {
+        StorageLayer mockStorageLayer = Mockito.mock(StorageLayer.class);
+        Mockito.when(mockStorageLayer.exists(Mockito.anyString())).thenReturn(true);
+        Mockito.when(mockStorageLayer.getSize(Mockito.anyString())).thenReturn(size);
+        return mockStorageLayer;
+    }
+}
