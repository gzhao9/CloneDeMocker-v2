+package org.apache.cloudstack.backup;
+
+import org.apache.cloudstack.backup.dao.BackupDao;
+import org.mockito.Mockito;
+
+public final class MockBackupDao {
+    private MockBackupDao() {
+    }
+
+    public static BackupDao createMockBackupDao(long backupId, Backup backup) {
+        BackupDao backupDao = Mockito.mock(BackupDao.class);
+        Mockito.when(backupDao.findById(backupId)).thenReturn(backup);
+        return backupDao;
+    }
+}
