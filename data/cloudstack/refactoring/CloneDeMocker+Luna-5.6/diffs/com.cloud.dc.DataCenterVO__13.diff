+package com.cloud.storage.snapshot;
+
+import com.cloud.dc.DataCenter;
+import com.cloud.dc.DataCenterVO;
+import org.mockito.Mockito;
+
+public final class MockDataCenterVO {
+    private MockDataCenterVO() {
+    }
+
+    public static DataCenterVO createMockDataCenterVO(final DataCenter.Type type) {
+        DataCenterVO zone = Mockito.mock(DataCenterVO.class);
+        Mockito.when(zone.getType()).thenReturn(type);
+        return zone;
+    }
+}
