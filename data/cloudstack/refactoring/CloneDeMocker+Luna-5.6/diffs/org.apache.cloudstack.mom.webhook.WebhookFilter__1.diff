@@ -0,0 +1,18 @@
+package org.apache.cloudstack.mom.webhook;
+
+import org.mockito.Mockito;
+
+public final class MockWebhookFilter {
+    private MockWebhookFilter() {
+    }
+
+    public static WebhookFilter createMockWebhookFilter(WebhookFilter.Mode mode,
+            WebhookFilter.MatchType matchType, String value) {
+        WebhookFilter includeFilter = Mockito.mock(WebhookFilter.class);
+        Mockito.when(includeFilter.getMode()).thenReturn(mode);
+        Mockito.when(includeFilter.getType()).thenReturn(WebhookFilter.Type.EventType);
+        Mockito.when(includeFilter.getMatchType()).thenReturn(matchType);
+        Mockito.when(includeFilter.getValue()).thenReturn(value);
+        return includeFilter;
+    }
+}
