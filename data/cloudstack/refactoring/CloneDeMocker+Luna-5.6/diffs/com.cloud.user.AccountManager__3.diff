@@ -0,0 +1,17 @@
+package org.apache.cloudstack.kms;
+
+import com.cloud.user.AccountManager;
+import org.mockito.Mockito;
+
+import static org.mockito.Mockito.when;
+
+public final class MockAccountManager {
+    private MockAccountManager() {
+    }
+
+    public static AccountManager createMockAccountManager(long accountId, boolean rootAdmin) {
+        AccountManager accountManager = Mockito.mock(AccountManager.class);
+        when(accountManager.isRootAdmin(accountId)).thenReturn(rootAdmin);
+        return accountManager;
+    }
+}
