+package com.cloud.hypervisor.kvm.resource.wrapper;
+
+import org.libvirt.Connect;
+import org.libvirt.LibvirtException;
+
+import static org.mockito.Mockito.when;
+
+public final class MockConnectWithDomainLookupFailure {
+    private MockConnectWithDomainLookupFailure() {
+    }
+
+    public static void configure(Connect connect, String vmName, LibvirtException libvirtException) throws LibvirtException {
+        when(connect.domainLookupByName(vmName)).thenThrow(libvirtException);
+    }
+}
