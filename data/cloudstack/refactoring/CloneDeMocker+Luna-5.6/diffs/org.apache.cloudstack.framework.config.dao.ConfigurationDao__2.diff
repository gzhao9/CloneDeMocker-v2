+package org.apache.cloudstack.framework.config.impl;
+
+import java.util.Map;
+
+import org.apache.cloudstack.framework.config.dao.ConfigurationDao;
+import org.apache.cloudstack.framework.config.dao.ConfigurationVO;
+import org.mockito.Mockito;
+
+public final class MockConfigurationDao {
+    private MockConfigurationDao() {
+    }
+
+    public static void configureMockConfigurationDao(ConfigurationDao configDao, Map<String, ConfigurationVO> configurationsByKey) {
+        configurationsByKey.forEach((key, configuration) ->
+                Mockito.when(configDao.findById(key)).thenReturn(configuration));
+    }
+}
