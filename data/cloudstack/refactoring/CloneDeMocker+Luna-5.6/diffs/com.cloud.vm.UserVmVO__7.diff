+package com.cloud.vm;
+
+import org.mockito.Mockito;
+
+import static org.mockito.Mockito.when;
+
+public final class MockUserVmVO {
+    private MockUserVmVO() {
+    }
+
+    public static UserVmVO createMockUserVmVO(VirtualMachine.State state) {
+        UserVmVO userVmVoMock = Mockito.mock(UserVmVO.class);
+        when(userVmVoMock.getState()).thenReturn(state);
+        return userVmVoMock;
+    }
+}
