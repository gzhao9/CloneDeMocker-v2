+
+public final class MockLibvirtComputingResource {
+    private MockLibvirtComputingResource() {
+    }
+
+    public static LibvirtComputingResource createMockLibvirtComputingResource(LibvirtUtilitiesHelper libvirtUtilitiesHelper) {
+        LibvirtComputingResource libvirtComputingResource = mock(LibvirtComputingResource.class);
+        when(libvirtComputingResource.getLibvirtUtilitiesHelper()).thenReturn(libvirtUtilitiesHelper);
+        return libvirtComputingResource;
+    }
