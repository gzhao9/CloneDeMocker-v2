+package com.cloud.api;
+
+import com.cloud.domain.DomainVO;
+import org.mockito.Mockito;
+
+public final class MockDomainVO {
+    private MockDomainVO() {
+    }
+
+    public static DomainVO createMockDomainVO(String uuid) {
+        DomainVO domainVOMock = Mockito.mock(DomainVO.class);
+        Mockito.when(domainVOMock.getUuid()).thenReturn(uuid);
+        return domainVOMock;
+    }
+}
