+package com.cloud.configuration;
+
+import org.apache.cloudstack.api.command.admin.network.CreateNetworkOfferingCmd;
+import org.mockito.Mockito;
+
+public class MockCreateNetworkOfferingCmd {
+
+    public static CreateNetworkOfferingCmd createMockCreateNetworkOfferingCmd(String guestIpTypeReturn) {
+        CreateNetworkOfferingCmd cmd = Mockito.mock(CreateNetworkOfferingCmd.class);
+        Mockito.when(cmd.getTraffictype()).thenReturn(com.cloud.network.Networks.TrafficType.Guest.toString());
+        Mockito.when(cmd.getGuestIpType()).thenReturn(guestIpTypeReturn);
+        return cmd;
+    }
+}
