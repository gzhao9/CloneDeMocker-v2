+package com.cloud.hypervisor.kvm.resource.wrapper;
+
+import com.cloud.hypervisor.kvm.storage.KVMStoragePool;
+import com.cloud.hypervisor.kvm.storage.KVMStoragePoolManager;
+import com.cloud.storage.Storage;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+public final class MockKVMStoragePoolManager {
+
+    private MockKVMStoragePoolManager() {
+    }
+
+    public static KVMStoragePoolManager createMockKVMStoragePoolManager(Storage.StoragePoolType poolType,
+                                                                          String poolUuid,
+                                                                          KVMStoragePool storagePool) {
+        KVMStoragePoolManager storagePoolManager = mock(KVMStoragePoolManager.class);
+        when(storagePoolManager.getStoragePool(poolType, poolUuid)).thenReturn(storagePool);
+        return storagePoolManager;
+    }
+}
