+package org.apache.cloudstack.storage.motion;
+
+import java.util.Map;
+
+import org.apache.cloudstack.storage.datastore.db.PrimaryDataStoreDao;
+import org.apache.cloudstack.storage.datastore.db.StoragePoolVO;
+
+import org.mockito.Mockito;
+
+public final class MockPrimaryDataStoreDao {
+    private MockPrimaryDataStoreDao() {
+    }
+
+    public static PrimaryDataStoreDao createMockPrimaryDataStoreDao(Map<Long, StoragePoolVO> storagePools) {
+        PrimaryDataStoreDao primaryDataStoreDao = Mockito.mock(PrimaryDataStoreDao.class);
+        for (Map.Entry<Long, StoragePoolVO> storagePool : storagePools.entrySet()) {
+            Mockito.doReturn(storagePool.getValue()).when(primaryDataStoreDao).findById(storagePool.getKey());
+        }
+        return primaryDataStoreDao;
+    }
+}
