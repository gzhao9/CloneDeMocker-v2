+package org.apache.cloudstack.kms;
+
+import static org.mockito.Mockito.when;
+
+import org.mockito.Mockito;
+
+public class MockKMSKey {
+    public static KMSKey createMockKMSKey(boolean enabled) {
+        KMSKey key = Mockito.mock(KMSKey.class);
+        when(key.isEnabled()).thenReturn(enabled);
+        return key;
+    }
+}
