+package com.cloud.network.guru;
+
+import com.cloud.dc.DataCenterVO;
+import com.cloud.dc.dao.DataCenterDao;
+import org.mockito.Mockito;
+
+public class MockDataCenterDaoFactory {
+    public static DataCenterDao createMockDataCenterDao(final DataCenterVO dataCenter) {
+        final DataCenterDao dataCenterDao = Mockito.mock(DataCenterDao.class);
+        Mockito.when(dataCenterDao.findById(Mockito.<Long>any())).thenReturn(dataCenter);
+        return dataCenterDao;
+    }
+}
