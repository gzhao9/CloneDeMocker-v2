+package com.cloud.network.guru;
+
+import com.cloud.dc.DataCenterVO;
+import com.cloud.dc.dao.DataCenterDao;
+import org.mockito.Mockito;
+
+public class MockDataCenterDaoFactory {
+    public static void configureMockDataCenterDao(final DataCenterDao dataCenterDao, final DataCenterVO dataCenter) {
+        Mockito.when(dataCenterDao.findById(dataCenter.getId())).thenReturn(dataCenter);
+    }
+}
