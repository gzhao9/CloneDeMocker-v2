+package com.cloud.storage.template;
+
+import java.io.File;
+
+import org.mockito.Mockito;
+
+public class MockFile {
+    public static File createMockFile(long fileLength) {
+        File mockFile = Mockito.mock(File.class);
+        Mockito.when(mockFile.length()).thenReturn(fileLength);
+        return mockFile;
+    }
+}
