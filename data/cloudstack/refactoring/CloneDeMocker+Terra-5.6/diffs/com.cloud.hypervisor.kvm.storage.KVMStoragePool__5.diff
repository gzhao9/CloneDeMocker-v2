+package com.cloud.hypervisor.kvm.resource.wrapper;
+
+import java.util.List;
+
+import org.mockito.Mockito;
+
+import com.cloud.hypervisor.kvm.storage.KVMPhysicalDisk;
+import com.cloud.hypervisor.kvm.storage.KVMStoragePool;
+
+public final class MockKVMStoragePoolWithPhysicalDisks {
+    private MockKVMStoragePoolWithPhysicalDisks() {
+    }
+
+    public static KVMStoragePool createMockKVMStoragePoolWithPhysicalDisks(List<KVMPhysicalDisk> physicalDisks) {
+        KVMStoragePool temporaryPool = Mockito.mock(KVMStoragePool.class);
+        Mockito.when(temporaryPool.listPhysicalDisks()).thenReturn(physicalDisks);
+        return temporaryPool;
+    }
+}
