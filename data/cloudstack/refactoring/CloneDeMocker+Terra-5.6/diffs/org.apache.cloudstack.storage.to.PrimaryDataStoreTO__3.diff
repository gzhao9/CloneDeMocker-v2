+package com.cloud.hypervisor.kvm.resource.wrapper;
+
+import org.apache.cloudstack.storage.to.PrimaryDataStoreTO;
+import org.mockito.Mockito;
+
+import com.cloud.storage.Storage;
+
+public class MockPrimaryDataStoreTO {
+    public static PrimaryDataStoreTO createMockPrimaryDataStore() {
+        PrimaryDataStoreTO primaryDataStore = Mockito.mock(PrimaryDataStoreTO.class);
+        Mockito.when(primaryDataStore.getPoolType()).thenReturn(Storage.StoragePoolType.NetworkFilesystem);
+        return primaryDataStore;
+    }
+}
