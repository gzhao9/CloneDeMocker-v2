+package org.apache.cloudstack.kms;
+
+import static org.mockito.Mockito.when;
+
+public final class MockHSMProfile {
+    private MockHSMProfile() {
+    }
+
+    public static void configureMockHSMProfile(HSMProfileVO profile, String protocol) {
+        when(profile.getProtocol()).thenReturn(protocol);
+    }
+}
