+package org.apache.cloudstack.kms;
+
+import org.mockito.Mockito;
+
+import com.cloud.user.AccountManager;
+
+public class MockAccountManagerWithRootAdmin {
+    public static void configureRootAdmin(AccountManager accountManager, long accountId, boolean rootAdmin) {
+        Mockito.when(accountManager.isRootAdmin(accountId)).thenReturn(rootAdmin);
+    }
