+package com.cloud.storage.snapshot;
+
+import com.cloud.storage.Snapshot;
+import com.cloud.storage.SnapshotVO;
+
+import org.mockito.Mockito;
+
+public final class MockSnapshotVO {
+    private MockSnapshotVO() {
+    }
+
+    public static SnapshotVO createMockSnapshotVO(Snapshot.State state) {
+        SnapshotVO snapshotVO = Mockito.mock(SnapshotVO.class);
+        Mockito.when(snapshotVO.getState()).thenReturn(state);
+        return snapshotVO;
+    }
+
+    public static SnapshotVO createMockSnapshotVO(Snapshot.State state, long volumeId) {
+        SnapshotVO snapshotVO = createMockSnapshotVO(state);
+        Mockito.when(snapshotVO.getVolumeId()).thenReturn(volumeId);
+        return snapshotVO;
+    }
+}
