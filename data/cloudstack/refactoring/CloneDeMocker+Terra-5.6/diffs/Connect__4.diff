@@ -0,0 +1,14 @@
+package com.cloud.hypervisor.kvm.resource.wrapper;
+
+import org.libvirt.Connect;
+import org.libvirt.Domain;
+import org.libvirt.LibvirtException;
+import org.mockito.Mockito;
+
+public class MockConnect {
+    public static Connect createMockConnect(String domainName, Domain domain) throws LibvirtException {
+        Connect connect = Mockito.mock(Connect.class);
+        Mockito.when(connect.domainLookupByName(domainName)).thenReturn(domain);
+        return connect;
+    }
+}
