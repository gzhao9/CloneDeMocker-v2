+
+public final class MockPrimaryDataStoreDaoConfiguration {
+    private MockPrimaryDataStoreDaoConfiguration() {
+    }
+
+    public static PrimaryDataStoreDao createMockPrimaryDataStoreDao(long[] poolIds, StoragePoolVO[] storagePools) {
+        PrimaryDataStoreDao storagePool = Mockito.mock(PrimaryDataStoreDao.class);
+        for (int index = 0; index < poolIds.length; index++) {
