+package com.cloud.configuration;
+
+import com.cloud.service.ServiceOfferingVO;
+import com.cloud.vm.VirtualMachine;
+
+import org.mockito.Mockito;
+
+public class MockSourceServiceOffering {
+    public static ServiceOfferingVO createMockSourceServiceOffering(Long sourceOfferingId) {
+        ServiceOfferingVO sourceOffering = Mockito.mock(ServiceOfferingVO.class);
+        Mockito.when(sourceOffering.getId()).thenReturn(sourceOfferingId);
+        Mockito.when(sourceOffering.getDisplayText()).thenReturn("Source Display Text");
+        Mockito.when(sourceOffering.getCpu()).thenReturn(2);
+        Mockito.when(sourceOffering.getSpeed()).thenReturn(1000);
+        Mockito.when(sourceOffering.getRamSize()).thenReturn(2048);
+        Mockito.when(sourceOffering.isOfferHA()).thenReturn(true);
+        Mockito.when(sourceOffering.getLimitCpuUse()).thenReturn(false);
+        Mockito.when(sourceOffering.isVolatileVm()).thenReturn(false);
+        Mockito.when(sourceOffering.isCustomized()).thenReturn(false);
+        Mockito.when(sourceOffering.isDynamicScalingEnabled()).thenReturn(true);
+        Mockito.when(sourceOffering.getDiskOfferingStrictness()).thenReturn(false);
+        Mockito.when(sourceOffering.isSystemUse()).thenReturn(false);
+        Mockito.when(sourceOffering.getVmType()).thenReturn(VirtualMachine.Type.User.toString());
+        return sourceOffering;
+    }
+}
