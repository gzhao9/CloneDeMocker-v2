+package com.cloud.configuration;
+
+import org.apache.cloudstack.api.command.admin.network.CreateNetworkOfferingCmd;
+import org.mockito.Mockito;
+
+public class MockCreateNetworkOfferingCommandFactory {
+    public static CreateNetworkOfferingCmd createMockCreateNetworkOfferingCommand(String trafficType, String guestIpType) {
+        CreateNetworkOfferingCmd cmd = Mockito.mock(CreateNetworkOfferingCmd.class);
+        Mockito.when(cmd.getGuestIpType()).thenReturn(guestIpType);
+        Mockito.when(cmd.getTraffictype()).thenReturn(trafficType);
+        return cmd;
+    }
+}
