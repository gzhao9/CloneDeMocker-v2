+package org.apache.cloudstack.network.contrail.model;
+
+import com.cloud.vm.VMInstanceVO;
+import com.cloud.vm.VirtualMachine;
+import org.mockito.Mockito;
+
+public class MockVMInstanceVO {
+    public static VMInstanceVO createMockVMInstanceVO(VirtualMachine.State state) {
+        VMInstanceVO vm = Mockito.mock(VMInstanceVO.class);
+        Mockito.when(vm.getInstanceName()).thenReturn("testVM1");
+        Mockito.when(vm.getState()).thenReturn(state);
+        Mockito.when(vm.getDomainId()).thenReturn(10L);
+        Mockito.when(vm.getAccountId()).thenReturn(42L);
+        return vm;
+    }
+}
