+package org.apache.cloudstack.mom.webhook;
+
+import org.mockito.Mockito;
+
+public class MockWebhookFilterFactory {
+    public static WebhookFilter createMockWebhookFilter(WebhookFilter.Mode mode, WebhookFilter.MatchType matchType, String value) {
+        WebhookFilter webhookFilter = Mockito.mock(WebhookFilter.class);
+        Mockito.when(webhookFilter.getMatchType()).thenReturn(matchType);
+        Mockito.when(webhookFilter.getMode()).thenReturn(mode);
+        Mockito.when(webhookFilter.getType()).thenReturn(WebhookFilter.Type.EventType);
+        Mockito.when(webhookFilter.getValue()).thenReturn(value);
+        return webhookFilter;
+    }
+}
