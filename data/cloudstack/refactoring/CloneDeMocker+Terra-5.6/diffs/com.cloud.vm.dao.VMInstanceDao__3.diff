+package org.apache.cloudstack.backup;
+
+import com.cloud.vm.VMInstanceVO;
+import com.cloud.vm.dao.VMInstanceDao;
+import org.mockito.Mockito;
+
+public class MockVMInstanceDaoHelper {
+    public static VMInstanceDao createMockVMInstanceDao(Long vmId, VMInstanceVO vm) {
+        VMInstanceDao vmInstanceDao = Mockito.mock(VMInstanceDao.class);
+        Mockito.when(vmInstanceDao.findByIdIncludingRemoved(vmId)).thenReturn(vm);
+        return vmInstanceDao;
+    }
