+package com.cloud.storage;
+
+import org.mockito.Mockito;
+
+public final class MockVolumeVOFactory {
+    private MockVolumeVOFactory() {
+    }
+
+    public static VolumeVO createMockVolumeVO(Long poolId) {
+        VolumeVO vmExistingVolume = Mockito.mock(VolumeVO.class);
+        Mockito.when(vmExistingVolume.getPoolId()).thenReturn(poolId);
+        return vmExistingVolume;
+    }
+}
