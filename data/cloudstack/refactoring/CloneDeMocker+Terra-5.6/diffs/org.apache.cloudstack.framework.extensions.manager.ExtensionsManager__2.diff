+package org.apache.cloudstack.framework.extensions.api;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.EnumSet;
+
+import org.apache.cloudstack.api.ApiConstants;
+import org.apache.cloudstack.api.response.ExtensionResponse;
+import org.apache.cloudstack.extension.Extension;
+import org.apache.cloudstack.framework.extensions.manager.ExtensionsManager;
+
+public class MockExtensionsManagerWithExtensionResponse {
+    public static ExtensionsManager createMockExtensionsManager(Extension extension, ExtensionResponse response) {
+        ExtensionsManager extensionsManager = mock(ExtensionsManager.class);
+        when(extensionsManager.createExtensionResponse(extension, EnumSet.of(ApiConstants.ExtensionDetails.all)))
+                .thenReturn(response);
+        return extensionsManager;
+    }
