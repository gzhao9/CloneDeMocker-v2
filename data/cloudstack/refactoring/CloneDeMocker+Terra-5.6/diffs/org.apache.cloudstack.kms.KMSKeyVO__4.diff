+package org.apache.cloudstack.kms;
+
+import org.apache.cloudstack.framework.kms.KeyPurpose;
+import org.mockito.Mockito;
+
+import static org.mockito.Mockito.when;
+
+public class KMSKeyMockFactory {
+    public static KMSKeyVO createMockKmsKey(KeyPurpose purpose) {
+        KMSKeyVO kmsKey = Mockito.mock(KMSKeyVO.class);
+        when(kmsKey.getPurpose()).thenReturn(purpose);
+        return kmsKey;
+    }
+}
