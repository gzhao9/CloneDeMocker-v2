+package com.cloud.network.guru;
+
+import com.cloud.dc.DataCenterVO;
+import com.cloud.network.Network;
+import com.cloud.network.NetworkModel;
+import com.cloud.utils.Pair;
+import org.mockito.Mockito;
+
+public class MockNetworkModelWithDnsPairs {
+    public static void configureMockNetworkModel(NetworkModel networkModel, Network network, DataCenterVO dataCenter, Pair<String, String> ip4Dns, Pair<String, String> ip6Dns) {
+        Mockito.when(networkModel.getNetworkIp4Dns(network, dataCenter)).thenReturn(ip4Dns);
+        Mockito.when(networkModel.getNetworkIp6Dns(network, dataCenter)).thenReturn(ip6Dns);
+    }
+}
