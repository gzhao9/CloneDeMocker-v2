+package org.apache.druid.query.aggregation.any;
+
+import org.apache.druid.segment.column.ColumnCapabilities;
+import org.mockito.Mockito;
+
+public class MockColumnCapabilities
+{
+  public static ColumnCapabilities createMockColumnCapabilities(boolean numeric)
+  {
+    ColumnCapabilities capabilities = Mockito.mock(ColumnCapabilities.class);
+    Mockito.doReturn(numeric).when(capabilities).isNumeric();
+    return capabilities;
+  }
+}
