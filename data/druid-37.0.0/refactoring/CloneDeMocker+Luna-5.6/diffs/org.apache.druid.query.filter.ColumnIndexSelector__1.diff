+package org.apache.druid.query.filter;
+
+import org.apache.druid.segment.column.ColumnIndexSupplier;
+import org.mockito.Mockito;
+
+public final class MockColumnIndexSelector
+{
+  private MockColumnIndexSelector()
+  {
+  }
+
+  public static ColumnIndexSelector createMockColumnIndexSelector(ColumnIndexSupplier indexSupplier)
+  {
+    final ColumnIndexSelector indexSelector = Mockito.mock(ColumnIndexSelector.class);
+    Mockito.when(indexSelector.getIndexSupplier("dim0")).thenReturn(indexSupplier);
+    return indexSelector;
+  }
+}
