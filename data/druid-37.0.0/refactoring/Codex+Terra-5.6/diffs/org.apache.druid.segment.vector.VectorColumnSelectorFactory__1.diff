+package org.apache.druid.query.aggregation.any;
+
+import org.apache.druid.segment.column.ColumnCapabilities;
+import org.apache.druid.segment.vector.VectorColumnSelectorFactory;
+import org.apache.druid.segment.vector.VectorValueSelector;
+import org.mockito.Mockito;
+
+final class AnyAggregatorFactoryTestUtils
+{
+  private AnyAggregatorFactoryTestUtils()
+  {
+  }
+
+  static void setupVectorColumnSelectorFactory(
+      final VectorColumnSelectorFactory selectorFactory,
+      final String fieldName,
+      final VectorValueSelector valueSelector
+  )
+  {
+    Mockito.doReturn(null).when(selectorFactory).getColumnCapabilities(fieldName);
+    Mockito.doReturn(valueSelector).when(selectorFactory).makeValueSelector(fieldName);
+  }
+
+  static void setupVectorColumnSelectorFactory(
+      final VectorColumnSelectorFactory selectorFactory,
+      final String fieldName,
+      final VectorValueSelector valueSelector,
+      final ColumnCapabilities capabilities,
+      final boolean isNumeric
+  )
+  {
+    setupVectorColumnSelectorFactory(selectorFactory, fieldName, valueSelector);
+    Mockito.doReturn(capabilities).when(selectorFactory).getColumnCapabilities(fieldName);
+    Mockito.doReturn(isNumeric).when(capabilities).isNumeric();
+  }
+}
