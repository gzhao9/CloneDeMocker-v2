+package org.apache.druid.indexing.common.actions;
+
+import com.google.common.base.Optional;
+import org.apache.druid.indexing.overlord.TaskRunner;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class TaskActionToolboxTestUtils
+{
+  private TaskActionToolboxTestUtils()
+  {
+    // Utility class.
+  }
+
+  static TaskActionToolbox createTaskActionToolbox(final TaskRunner runner)
+  {
+    final TaskActionToolbox toolbox = mock(TaskActionToolbox.class);
+    when(toolbox.getTaskRunner()).thenReturn(Optional.of(runner));
+    return toolbox;
+  }
