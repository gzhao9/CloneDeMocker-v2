+package org.apache.druid.query.filter;
+
+import org.apache.druid.segment.column.ColumnIndexSupplier;
+import org.mockito.Mockito;
+
+final class ColumnIndexSelectorTestUtils
+{
+  private ColumnIndexSelectorTestUtils()
+  {
+    // No instantiation.
+  }
+
+  static ColumnIndexSelector makeIndexSelector(final String column, final ColumnIndexSupplier indexSupplier)
+  {
+    final ColumnIndexSelector indexSelector = Mockito.mock(ColumnIndexSelector.class);
+    Mockito.when(indexSelector.getIndexSupplier(column)).thenReturn(indexSupplier);
+    return indexSelector;
+  }
+}
