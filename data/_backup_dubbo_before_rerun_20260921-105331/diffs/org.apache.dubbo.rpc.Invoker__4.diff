+package org.apache.dubbo.rpc.filter;
+
+import org.apache.dubbo.common.URL;
+import org.apache.dubbo.rpc.Invoker;
+import org.apache.dubbo.rpc.support.DemoService;
+
+import org.mockito.Mockito;
+
+public class MockDemoServiceInvoker {
+
+    public static Invoker createMockInvoker() {
+        Invoker invoker = Mockito.mock(Invoker.class);
+        Mockito.when(invoker.getInterface()).thenReturn(DemoService.class);
+        return invoker;
+    }
+
+    public static Invoker createMockInvoker(URL url) {
+        Invoker invoker = createMockInvoker();
+        Mockito.when(invoker.getUrl()).thenReturn(url);
+        return invoker;
+    }
+}
