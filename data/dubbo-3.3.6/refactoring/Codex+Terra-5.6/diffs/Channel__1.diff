+package org.apache.dubbo.remoting.transport.netty4;
+
+import io.netty.buffer.PooledByteBufAllocator;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelPromise;
+import org.mockito.Mockito;
+
+final class ChannelMockUtils {
+    private ChannelMockUtils() {}
+
+    static void stubAllocator(Channel channel) {
+        Mockito.when(channel.alloc()).thenReturn(PooledByteBufAllocator.DEFAULT);
+    }
+
+    static void stubNewPromise(Channel channel, ChannelPromise future) {
+        Mockito.when(channel.newPromise()).thenReturn(future);
+    }
+}
