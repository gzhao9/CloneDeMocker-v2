+package org.apache.dubbo.remoting.telnet.support;
+
+import org.apache.dubbo.common.URL;
+import org.apache.dubbo.remoting.Channel;
+
+import org.mockito.Mockito;
+
+final class ChannelMockUtils {
+    private ChannelMockUtils() {}
+
+    static Channel mockChannel(URL url) {
+        Channel channel = Mockito.mock(Channel.class);
+        stubUrl(channel, url);
+        return channel;
+    }
+
+    static void stubUrl(Channel channel, URL url) {
+        Mockito.when(channel.getUrl()).thenReturn(url);
+    }
+}
