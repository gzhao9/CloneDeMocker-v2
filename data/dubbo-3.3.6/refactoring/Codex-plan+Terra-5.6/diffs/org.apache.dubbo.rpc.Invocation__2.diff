+package org.apache.dubbo.rpc.filter;
+
+import org.apache.dubbo.rpc.Invocation;
+
+import org.mockito.Mockito;
+
+import static org.mockito.Mockito.when;
+
+public class MockInvocationWithMethodName {
+
+    public static <T extends Invocation> T createMockInvocationWithMethodName(
+            Class<T> invocationClass, String methodName) {
+        T invocation = Mockito.mock(invocationClass);
+        when(invocation.getMethodName()).thenReturn(methodName);
+        return invocation;
+    }
+}
