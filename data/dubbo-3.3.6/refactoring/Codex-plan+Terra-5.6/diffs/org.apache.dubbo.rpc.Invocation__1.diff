+package org.apache.dubbo.rpc.filter;
+
+import org.apache.dubbo.rpc.Invocation;
+
+import org.mockito.Mockito;
+
+import static org.mockito.BDDMockito.given;
+
+public class MockInvocationWithMethodDetails {
+
+    public static <T extends Invocation> T createMockInvocation(
+            Class<T> invocationType, String methodName, Class<?>[] parameterTypes) {
+        T invocation = Mockito.mock(invocationType);
+        given(invocation.getMethodName()).willReturn(methodName);
+        given(invocation.getParameterTypes()).willReturn(parameterTypes);
+        given(invocation.getArguments()).willReturn(new Object[] {"hello"});
+        return invocation;
+    }
+}
