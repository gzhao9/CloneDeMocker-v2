+package org.apache.dubbo.rpc.cluster.support;
+
+import org.apache.dubbo.common.URL;
+import org.apache.dubbo.rpc.cluster.Directory;
+import org.apache.dubbo.rpc.cluster.filter.DemoService;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.BDDMockito.given;
+
+public final class MockDirectory {
+
+    private MockDirectory() {
+    }
+
+    public static Directory<DemoService> createMockDirectory(URL url) {
+        Directory<DemoService> dic = mock(Directory.class);
+        given(dic.getUrl()).willReturn(url);
+        given(dic.getConsumerUrl()).willReturn(url);
+        given(dic.getInterface()).willReturn(DemoService.class);
+        return dic;
+    }
+}
