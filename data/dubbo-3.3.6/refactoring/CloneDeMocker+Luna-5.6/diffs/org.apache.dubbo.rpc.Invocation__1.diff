@@ -0,0 +1,23 @@
+package org.apache.dubbo.rpc.filter;
+
+import org.apache.dubbo.rpc.Invocation;
+import org.mockito.Mockito;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockInvocationWithCommonStubs {
+
+    private MockInvocationWithCommonStubs() {
+    }
+
+    public static Invocation createMockInvocation(Class<? extends Invocation> invocationClass,
+                                                   String methodName,
+                                                   Class<?>[] parameterTypes,
+                                                   Object[] arguments) {
+        Invocation invocation = Mockito.mock(invocationClass);
+        given(invocation.getMethodName()).willReturn(methodName);
+        given(invocation.getParameterTypes()).willReturn(parameterTypes);
+        given(invocation.getArguments()).willReturn(arguments);
+        return invocation;
+    }
+}
