+package org.apache.dubbo.qos.command.impl;
+
+import org.apache.dubbo.qos.api.CommandContext;
+
+import org.mockito.Mockito;
+
+public class MockCommandContext {
+
+    public static CommandContext createMockCommandContext(boolean isHttp) {
+        CommandContext commandContext = Mockito.mock(CommandContext.class);
+        Mockito.when(commandContext.isHttp()).thenReturn(isHttp);
+        return commandContext;
+    }
+}
