@@ -0,0 +1,25 @@
+package org.springframework.security.oauth2.server.authorization.web;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+import org.mockito.Mockito;
+
+import org.springframework.security.authentication.AuthenticationDetailsSource;
+import org.springframework.security.web.authentication.WebAuthenticationDetails;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockAuthenticationDetailsSource {
+
+	private MockAuthenticationDetailsSource() {
+	}
+
+	public static AuthenticationDetailsSource<HttpServletRequest, WebAuthenticationDetails> createMockAuthenticationDetailsSource(
+			HttpServletRequest request, WebAuthenticationDetails webAuthenticationDetails) {
+		AuthenticationDetailsSource<HttpServletRequest, WebAuthenticationDetails> authenticationDetailsSource = Mockito
+				.mock(AuthenticationDetailsSource.class);
+		given(authenticationDetailsSource.buildDetails(request)).willReturn(webAuthenticationDetails);
+		return authenticationDetailsSource;
+	}
+
+}
