+package org.springframework.security.oauth2.client.web.reactive.function.client;
+
+import java.util.Collections;
+
+import org.mockito.Mockito;
+
+import org.springframework.http.HttpHeaders;
+import org.springframework.web.reactive.function.client.ClientResponse;
+
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.BDDMockito.given;
+
+public final class MockClientResponseHeaders {
+
+	private MockClientResponseHeaders() {
+	}
+
+	public static ClientResponse.Headers createMockClientResponseHeaders() {
+		ClientResponse.Headers headers = Mockito.mock(ClientResponse.Headers.class);
+		given(headers.header(eq(HttpHeaders.WWW_AUTHENTICATE)))
+			.willReturn(Collections.singletonList("Bearer error=\"insufficient_scope\", "
+				+ "error_description=\"The request requires higher privileges than provided by the access token.\", "
+				+ "error_uri=\"https://tools.ietf.org/html/rfc6750#section-3.1\""));
+		return headers;
+	}
+
+}
