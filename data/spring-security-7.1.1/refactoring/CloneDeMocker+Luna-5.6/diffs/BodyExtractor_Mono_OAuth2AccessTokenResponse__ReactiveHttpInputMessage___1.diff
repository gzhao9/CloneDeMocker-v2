+package org.springframework.security.oauth2.client.endpoint;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.BDDMockito.given;
+
+import org.mockito.Mockito;
+
+import org.springframework.http.ReactiveHttpInputMessage;
+import org.springframework.security.oauth2.core.endpoint.OAuth2AccessTokenResponse;
+import org.springframework.web.reactive.function.BodyExtractor;
+
+import reactor.core.publisher.Mono;
+
+public final class MockBodyExtractor {
+
+	private MockBodyExtractor() {
+	}
+
+	public static BodyExtractor<Mono<OAuth2AccessTokenResponse>, ReactiveHttpInputMessage> createMockBodyExtractor(
+			OAuth2AccessTokenResponse response) {
+		BodyExtractor<Mono<OAuth2AccessTokenResponse>, ReactiveHttpInputMessage> extractor = Mockito
+				.mock(BodyExtractor.class);
+		given(extractor.extract(any(), any())).willReturn(Mono.just(response));
+		return extractor;
+	}
+
+}
