+package org.springframework.security.web.server.header;
+
+import org.mockito.Mockito;
+import reactor.core.publisher.Mono;
+
+import org.springframework.web.server.ServerWebExchange;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockServerHttpHeadersWriterWithExchange {
+
+	private MockServerHttpHeadersWriterWithExchange() {
+	}
+
+	public static ServerHttpHeadersWriter createMockServerHttpHeadersWriter(ServerWebExchange exchange) {
+		ServerHttpHeadersWriter writer = Mockito.mock(ServerHttpHeadersWriter.class);
+		given(writer.writeHttpHeaders(exchange)).willReturn(Mono.empty());
+		return writer;
+	}
