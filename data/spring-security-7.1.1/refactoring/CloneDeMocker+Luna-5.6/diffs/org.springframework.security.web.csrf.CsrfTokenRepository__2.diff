@@ -0,0 +1,23 @@
+package org.springframework.security.web.csrf;
+
+import static org.mockito.BDDMockito.given;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.mockito.Mockito;
+
+public final class MockCsrfTokenRepository {
+
+	private MockCsrfTokenRepository() {
+	}
+
+	public static CsrfTokenRepository createMockCsrfTokenRepository(HttpServletRequest request,
+			HttpServletResponse response, CsrfToken token) {
+		CsrfTokenRepository tokenRepository = Mockito.mock(CsrfTokenRepository.class);
+		given(tokenRepository.loadDeferredToken(request, response))
+				.willReturn(new TestDeferredCsrfToken(token, false));
+		return tokenRepository;
+	}
+
+}
