+package org.springframework.security.authorization;
+
+import org.springframework.aop.Pointcut;
+import org.springframework.security.authorization.method.AuthorizationAdvisor;
+
+import static org.mockito.BDDMockito.given;
+import static org.mockito.Mockito.mock;
+
+public final class MockAuthorizationAdvisor {
+
+	private MockAuthorizationAdvisor() {
+	}
+
+	public static AuthorizationAdvisor createMockAuthorizationAdvisor() {
+		AuthorizationAdvisor advisor = mock(AuthorizationAdvisor.class);
+		given(advisor.getAdvice()).willReturn(advisor);
+		given(advisor.getPointcut()).willReturn(Pointcut.TRUE);
+		return advisor;
+	}
+
+}
