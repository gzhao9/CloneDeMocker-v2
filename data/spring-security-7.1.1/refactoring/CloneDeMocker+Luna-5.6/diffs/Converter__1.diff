+package org.springframework.security.oauth2.core.http.converter;
+
+import org.mockito.Mockito;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.BDDMockito.given;
+
+import org.springframework.core.convert.converter.Converter;
+
+public final class MockConverter {
+
+	private MockConverter() {
+	}
+
+	public static Converter createMockConverter() {
+		Converter converter = Mockito.mock(Converter.class);
+		given(converter.convert(any())).willThrow(RuntimeException.class);
+		return converter;
+	}
+
+}
