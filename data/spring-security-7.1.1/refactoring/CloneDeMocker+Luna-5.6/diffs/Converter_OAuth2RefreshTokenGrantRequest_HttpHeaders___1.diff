+package org.springframework.security.oauth2.client.endpoint;
+
+import org.mockito.Mockito;
+
+import org.springframework.http.HttpHeaders;
+import org.springframework.util.unit.DataSize;
+import org.springframework.core.convert.converter.Converter;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockHeadersConverter {
+
+	private MockHeadersConverter() {
+	}
+
+	public static Converter<OAuth2RefreshTokenGrantRequest, HttpHeaders> createMockHeadersConverter(
+			OAuth2RefreshTokenGrantRequest request, HttpHeaders headers) {
+		Converter<OAuth2RefreshTokenGrantRequest, HttpHeaders> headersConverter = Mockito.mock();
+		given(headersConverter.convert(request)).willReturn(headers);
+		return headersConverter;
+	}
+
+}
