+package org.springframework.security.oauth2.client.endpoint;
+
+import org.mockito.Mockito;
+import org.springframework.core.convert.converter.Converter;
+import org.springframework.util.MultiValueMap;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockOAuth2RefreshTokenParametersConverter {
+
+	private MockOAuth2RefreshTokenParametersConverter() {
+	}
+
+	public static Converter<OAuth2RefreshTokenGrantRequest, MultiValueMap<String, String>> createMockRefreshTokenParametersConverter(
+			OAuth2RefreshTokenGrantRequest grantRequest, MultiValueMap<String, String> parameters) {
+		Converter<OAuth2RefreshTokenGrantRequest, MultiValueMap<String, String>> parametersConverter = Mockito.mock();
+		given(parametersConverter.convert(grantRequest)).willReturn((MultiValueMap<String, String>) parameters);
+		return parametersConverter;
+	}
+
+}
