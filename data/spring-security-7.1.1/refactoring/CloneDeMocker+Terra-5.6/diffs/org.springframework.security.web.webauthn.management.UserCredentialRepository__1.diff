+package org.springframework.security.web.webauthn.management;
+
+import org.springframework.security.web.webauthn.api.Bytes;
+import org.springframework.security.web.webauthn.api.ImmutableCredentialRecord;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockUserCredentialRepository {
+
+	private MockUserCredentialRepository() {
+	}
+
+	public static void stubFindByCredentialId(UserCredentialRepository userCredentials, Bytes credentialId,
+			ImmutableCredentialRecord credentialRecord) {
+		given(userCredentials.findByCredentialId(credentialId)).willReturn(credentialRecord);
+	}
+
+}
