+package org.springframework.security.web.webauthn.management;
+
+import org.springframework.security.web.webauthn.api.PublicKeyCredentialUserEntity;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockPublicKeyCredentialUserEntityRepository {
+
+	private MockPublicKeyCredentialUserEntityRepository() {
+	}
+
+	public static void givenUserEntity(PublicKeyCredentialUserEntityRepository userEntities, String username,
