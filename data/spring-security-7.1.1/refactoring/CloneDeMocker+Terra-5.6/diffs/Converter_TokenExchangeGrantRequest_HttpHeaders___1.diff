+package org.springframework.security.oauth2.client.endpoint;
+
+import org.mockito.Mockito;
+
+import org.springframework.core.convert.converter.Converter;
+import org.springframework.http.HttpHeaders;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockTokenExchangeHeadersConverter {
+
+	private MockTokenExchangeHeadersConverter() {
+	}
+
+	public static Converter<TokenExchangeGrantRequest, HttpHeaders> createMockTokenExchangeHeadersConverter(
+			TokenExchangeGrantRequest grantRequest, HttpHeaders headers) {
+		Converter<TokenExchangeGrantRequest, HttpHeaders> headersConverter = Mockito.mock();
+		given(headersConverter.convert(grantRequest)).willReturn(headers);
+		return headersConverter;
+	}
+
+}
