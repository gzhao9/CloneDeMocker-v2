+package org.springframework.security.web.server.util.matcher;
+
+import java.util.Map;
+
+import org.springframework.web.server.ServerWebExchange;
+
+import static org.mockito.BDDMockito.given;
+
+final class MockServerWebExchangeMatcher {
+
+	private MockServerWebExchangeMatcher() {
+	}
+
+	static void givenMatch(ServerWebExchangeMatcher matcher, ServerWebExchange exchange, Map<String, Object> params) {
+		given(matcher.matches(exchange)).willReturn(ServerWebExchangeMatcher.MatchResult.match(params));
+	}
+
+}
