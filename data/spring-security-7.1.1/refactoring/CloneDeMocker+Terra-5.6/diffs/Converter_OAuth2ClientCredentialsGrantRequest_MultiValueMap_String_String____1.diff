+package org.springframework.security.oauth2.client.endpoint;
+
+import org.mockito.Mockito;
+import org.springframework.core.convert.converter.Converter;
+import org.springframework.util.MultiValueMap;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockOAuth2ClientCredentialsGrantRequestParametersConverter {
+
+	private MockOAuth2ClientCredentialsGrantRequestParametersConverter() {
+	}
+
+	public static Converter<OAuth2ClientCredentialsGrantRequest, MultiValueMap<String, String>> createMockParametersConverter(
+			OAuth2ClientCredentialsGrantRequest grantRequest, MultiValueMap<String, String> parameters) {
+		Converter<OAuth2ClientCredentialsGrantRequest, MultiValueMap<String, String>> parametersConverter = Mockito.mock();
+		given(parametersConverter.convert(grantRequest)).willReturn(parameters);
+		return parametersConverter;
+	}
+
+}
