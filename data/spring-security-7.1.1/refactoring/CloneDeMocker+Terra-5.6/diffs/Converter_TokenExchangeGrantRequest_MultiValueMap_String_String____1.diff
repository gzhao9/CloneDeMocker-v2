+package org.springframework.security.oauth2.client.endpoint;
+
+import org.mockito.BDDMockito;
+import org.mockito.Mockito;
+import org.springframework.core.convert.converter.Converter;
+import org.springframework.util.MultiValueMap;
+
+public final class MockTokenExchangeParametersConverter {
+
+	private MockTokenExchangeParametersConverter() {
+	}
+
+	@SuppressWarnings("unchecked")
+	public static Converter<TokenExchangeGrantRequest, MultiValueMap<String, String>> createMockTokenExchangeParametersConverter(
+			TokenExchangeGrantRequest grantRequest, MultiValueMap<String, String> parameters) {
+		Converter<TokenExchangeGrantRequest, MultiValueMap<String, String>> parametersConverter = Mockito.mock(Converter.class);
+		BDDMockito.given(parametersConverter.convert(grantRequest)).willReturn(parameters);
+		return parametersConverter;
+	}
+
+}
