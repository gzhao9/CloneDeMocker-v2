+package org.springframework.security.web.csrf;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+
+import static org.mockito.BDDMockito.given;
+
+public final class MockCsrfTokenRepositoryWithDeferredToken {
+
+	private MockCsrfTokenRepositoryWithDeferredToken() {
+	}
+
+	public static void stubLoadDeferredToken(CsrfTokenRepository tokenRepository, HttpServletRequest request,
+			HttpServletResponse response, DeferredCsrfToken deferredToken) {
+		given(tokenRepository.loadDeferredToken(request, response)).willReturn(deferredToken);
+	}
+
+}
